<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- SMS para o cuidador quando o relógio detecta uma queda/crise e a
         pessoa não responde (ver data/sync/MobileDataLayerService.kt).
         O pedido na tela é feito em MainActivity. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- required=false: o app instala também em aparelhos sem chip (o envio só falha). -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Telainicial">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AcessibilidadeActivity"
            android:exported="false" />

        <activity
            android:name=".BatimentosActivity"
            android:exported="false" />

        <activity
            android:name=".PerfilActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LeitorImagemActivity"
            android:exported="false" />

        <!-- Recebe as mensagens do relógio (data/sync/MobileDataLayerService.kt),
             mesmo com o app fechado. exported="true" é obrigatório para o
             sistema conseguir entregar a mensagem a este Service. -->
        <service
            android:name=".data.sync.MobileDataLayerListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <!-- "/alira" cobre todos os caminhos do app
                     (/alira/alerta, /alira/emergencia, /alira/leituras). -->
                <data
                    android:host="*"
                    android:pathPrefix="/alira"
                    android:scheme="wear" />
            </intent-filter>
        </service>

    </application>

</manifest>