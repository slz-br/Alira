<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Alira">
        <!-- Agora é a LoginActivity que abre primeiro (LAUNCHER), não a
             MainActivity — o app precisa autenticar o Usuario (RF08) antes
             de mostrar a tela principal. MainActivity continua declarada
             abaixo, sem intent-filter de LAUNCHER, e é aberta pelo próprio
             código (ver LoginActivity.handleLogin()). -->
        <activity
            android:name=".presentation.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.CadastroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Recebe os alertas enviados pelo relógio (data/sync/MobileDataLayerService.kt).
             android:exported="true" é obrigatório para o sistema conseguir
             despachar a mensagem da Data Layer API até este Service — mesmo
             padrão do WearDataLayerListenerService no :wear. -->
        <service
            android:name=".data.sync.MobileDataLayerListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
            </intent-filter>
        </service>
    </application>

</manifest>