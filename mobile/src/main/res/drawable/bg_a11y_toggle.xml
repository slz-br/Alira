<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/accent_purple" />
            <stroke
                android:width="1dp"
                android:color="@color/accent_purple_light" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/a11y_toggle_fill" />
            <stroke
                android:width="1dp"
                android:color="@color/a11y_toggle_stroke" />
        </shape>
    </item>
</selector>
