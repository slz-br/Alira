<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000"
    tools:context=".AcessibilidadeActivity">

    <!-- ===================== CONTEÚDO PRINCIPAL (1º filho do DrawerLayout) ===================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Botão que abre o menu -->
        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="96dp"
            android:layout_height="72dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Abrir menu"
            android:padding="10dp"
            android:src="@drawable/ic_menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView3"
            android:contentDescription="Logo Alira, voltar para a tela inicial"
            android:layout_width="114dp"
            android:layout_height="81dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/logo_alira" />

        <!-- ===================== CONTEÚDO ROLÁVEL (as duas imagens na mesma tela) ===================== -->
        <ScrollView
            android:id="@+id/scroll_acessibilidade"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageView3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="40dp">

                <!-- ===================== TÍTULO ===================== -->
                <TextView
                    android:id="@+id/acc_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/rela_buttonback"
                    android:paddingStart="34dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="34dp"
                    android:paddingBottom="8dp"
                    android:tag="compacto"
                    android:text="Acessibilidade"
                    android:textColor="#E0E0E0"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <!-- ===================== LEITOR DE TELA (ON / OFF) ===================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp">

                    <TextView
                        android:id="@+id/acc_leitor_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Leitor de tela"
                        android:textColor="#E0E0E0"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:id="@+id/switch_track"
                        android:layout_width="134dp"
                        android:layout_height="70dp"
                        android:background="@drawable/acc_toggle_track"
                        android:clickable="true"
                        android:contentDescription="Ativar ou desativar o leitor de tela"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/switch_thumb"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="@drawable/acc_toggle_thumb"
                            android:gravity="center"
                            android:tag="compacto"
                            android:text="OFF"
                            android:textColor="#E0E0E0"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Divisor -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FFFFFF" />

                <!-- ===================== MUDAR FONTE ===================== -->
                <TextView
                    android:id="@+id/acc_fonte_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="24dp"
                    android:text="Mudar fonte"
                    android:textColor="#E0E0E0"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/acc_card_bg"
                    android:columnCount="1"
                    android:paddingStart="24dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/font_quicksand"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:padding="10dp"
                        android:text="Quicksand"
                        android:textColor="#4A7CF0"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/font_opendyslexic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="8dp"
                        android:padding="10dp"
                        android:text="OpenDyslexic"
                        android:textColor="#E0E0E0"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/font_arial"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="8dp"
                        android:padding="10dp"
                        android:text="Arial"
                        android:textColor="#E0E0E0"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </GridLayout>

                <!-- ===================== TAMANHO DA FONTE ===================== -->
                <TextView
                    android:id="@+id/acc_tam_fonte_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="36dp"
                    android:text="Tamanho da fonte"
                    android:textColor="#E0E0E0"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/acc_card_bg"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="40dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="40dp">

                    <SeekBar
                        android:id="@+id/seek_fonte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="Tamanho da fonte"
                        android:max="100"
                        android:maxHeight="2dp"
                        android:minHeight="2dp"
                        android:progress="25"
                        android:progressBackgroundTint="#FFFFFF"
                        android:progressDrawable="@drawable/acc_seek_progress"
                        android:progressTint="#6A5ACD"
                        android:splitTrack="false"
                        android:thumb="@drawable/acc_seek_thumb"
                        android:thumbTint="#6A5ACD" />
                </LinearLayout>

                <!-- ===================== TAMANHO DOS BOTÕES ===================== -->
                <TextView
                    android:id="@+id/acc_tam_botoes_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="36dp"
                    android:text="Tamanho dos botões"
                    android:textColor="#E0E0E0"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/acc_card_bg"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="30dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <SeekBar
                        android:id="@+id/seek_botoes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Tamanho dos botões"
                        android:max="100"
                        android:maxHeight="2dp"
                        android:minHeight="2dp"
                        android:progress="20"
                        android:progressBackgroundTint="#FFFFFF"
                        android:progressDrawable="@drawable/acc_seek_progress"
                        android:progressTint="#3F5FBF"
                        android:splitTrack="false"
                        android:thumb="@drawable/acc_seek_thumb"
                        android:thumbTint="#3F5FBF" />

                    <!-- Pré-visualização do botão (altura muda conforme a bolinha) -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="24dp">

                        <View
                            android:id="@+id/preview_botao"
                            android:layout_width="match_parent"
                            android:layout_height="68dp"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/acc_preview_button" />
                    </FrameLayout>
                </LinearLayout>

                <!-- ===================== TEMA ===================== -->
                <TextView
                    android:id="@+id/acc_tema_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="36dp"
                    android:text="Tema"
                    android:textColor="#E0E0E0"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/acc_card_bg"
                    android:columnCount="1"
                    android:paddingStart="24dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/tema_escuro"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:padding="10dp"
                        android:text="Escuro"
                        android:textColor="#4A7CF0"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tema_contraste"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="8dp"
                        android:padding="10dp"
                        android:text="Alto contraste"
                        android:textColor="#E0E0E0"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tema_claro"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="8dp"
                        android:padding="10dp"
                        android:text="Claro"
                        android:textColor="#E0E0E0"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </GridLayout>

            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===================== MENU LATERAL ===================== -->
    <include
        layout="@layout/layout_drawer_menu"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>