<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptado do protótipo telainicial/app/.../tela_login.xml. Uma peça foi
    removida na migração: a View decorativa "com.example.panda4.StarfieldView"
    (fundo de estrelas animado) — essa classe não existe em nenhum arquivo
    deste projeto (só era referenciada no XML original), então incluí-la
    aqui quebraria a compilação. O fundo continua com o degradê
    (bg_gradient_galaxy) do FrameLayout; a animação de estrelas pode ser
    adicionada depois, se você recuperar/recriar essa classe.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_galaxy"
    tools:context=".presentation.LoginActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <ImageButton
                android:id="@+id/btnAccessibility"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_a11y_toggle"
                android:contentDescription="Ativar modo de acessibilidade com alto contraste e texto ampliado"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_accessibility"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="180dp"
                android:layout_height="96dp"
                android:layout_marginTop="16dp"
                android:contentDescription="Logo ALIRA"
                android:scaleType="fitCenter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnAccessibility"
                app:srcCompat="@drawable/logoalira" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bem-vindo de volta"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgLogo" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/glassCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_glass_card"
                android:padding="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
                app:layout_constraintWidth_max="480dp">

                <TextView
                    android:id="@+id/tvFormTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="Entrar"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvLoginLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:labelFor="@id/etLogin"
                    android:text="E-mail"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvFormTitle" />

                <EditText
                    android:id="@+id/etLogin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:autofillHints="username"
                    android:background="@drawable/bg_edittext_field"
                    android:contentDescription="Campo de e-mail"
                    android:hint="Digite seu e-mail"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:minHeight="52dp"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLoginLabel" />

                <TextView
                    android:id="@+id/tvSenhaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:labelFor="@id/etSenha"
                    android:text="Senha"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/etLogin" />

                <EditText
                    android:id="@+id/etSenha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:autofillHints="password"
                    android:background="@drawable/bg_edittext_field"
                    android:contentDescription="Campo de senha"
                    android:hint="Digite sua senha"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:minHeight="52dp"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSenhaLabel" />

                <CheckBox
                    android:id="@+id/cbMostrarSenha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:contentDescription="Alternar exibição da senha digitada"
                    android:minHeight="48dp"
                    android:text="Mostrar senha"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/etSenha" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnProsseguir"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/leitor_buttonback"
                    android:contentDescription="Entrar"
                    android:stateListAnimator="@null"
                    android:text="Entrar"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cbMostrarSenha" />

                <TextView
                    android:id="@+id/tvCadastro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="Ir para tela de cadastro"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:text="Não tem uma conta? Cadastre-se"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btnProsseguir" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</FrameLayout>
