<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000"
    tools:context=".MainActivity">

    <!-- ===================== CONTEÚDO PRINCIPAL (1º filho do DrawerLayout) ===================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Botão que abre o menu -->
        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="96dp"
            android:layout_height="72dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Abrir menu"
            android:padding="10dp"
            android:src="@drawable/ic_menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Logo -->
        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="114dp"
            android:layout_height="81dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="Logo Alira, voltar para a tela inicial"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/logo_alira" />

        <!-- Rolagem + cartões que crescem com o tamanho da fonte (antes: alturas e posições fixas) -->
        <ScrollView
            android:id="@+id/scroll_home"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageView3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="23dp"
                android:paddingEnd="14dp"
                android:paddingBottom="32dp">

                <!-- ===================== RELATÓRIOS ===================== -->
                <LinearLayout
                    android:id="@+id/rela_buttonback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rela_buttonback"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:minHeight="162dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:tag="botao">

                    <TextView
                        android:id="@+id/relatorios_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="compacto"
                        android:text="Relatórios:"
                        android:textColor="#FFFFFF"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Acesse aqui seus relatórios personalizados"
                        android:textColor="@color/white"
                        android:textSize="23sp" />
                </LinearLayout>

                <!-- ===================== BATIMENTOS CARDÍACOS ===================== -->
                <LinearLayout
                    android:id="@+id/bat_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/bat_buttomback"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="94dp"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:tag="botao">

                    <ImageView
                        android:id="@+id/bat_icon"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:contentDescription="Ícone de batimentos cardíacos"
                        android:src="@drawable/img_heartbeat" />

                    <TextView
                        android:id="@+id/bat_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="Batimentos cardíacos"
                        android:textColor="#FFFFFF"
                        android:textSize="25sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- ===================== LEITOR DE TELA ===================== -->
                <LinearLayout
                    android:id="@+id/leitor_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/leitor_buttonback"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="92dp"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:tag="botao">

                    <ImageView
                        android:id="@+id/leitor_icon"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:contentDescription="Ícone de leitor de tela"
                        android:src="@drawable/img_song" />

                    <TextView
                        android:id="@+id/leitor_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="Leitor de tela"
                        android:textColor="#FFFFFF"
                        android:textSize="25sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- ===================== LEITOR DE IMAGEM ===================== -->
                <LinearLayout
                    android:id="@+id/image_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/image_buttonback"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="88dp"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:tag="botao">

                    <ImageView
                        android:id="@+id/image_icon"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:contentDescription="Ícone de leitor de imagem"
                        android:src="@drawable/img_icon" />

                    <TextView
                        android:id="@+id/image_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="Leitor de imagem"
                        android:textColor="#FFFFFF"
                        android:textSize="25sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===================== MENU LATERAL ===================== -->
    <include
        layout="@layout/layout_drawer_menu"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
