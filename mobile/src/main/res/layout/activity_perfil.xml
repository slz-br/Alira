<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000"
    tools:context=".PerfilActivity">

    <!-- ===================== CONTEÚDO PRINCIPAL (1º filho do DrawerLayout) ===================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Faixa preta do topo (menu + logo) -->
        <View
            android:id="@+id/header_bar"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:background="#000000"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Botão que abre o menu -->
        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="96dp"
            android:layout_height="72dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Abrir menu"
            android:padding="10dp"
            android:src="@drawable/ic_menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView3"
            android:contentDescription="Logo Alira, voltar para a tela inicial"
            android:layout_width="114dp"
            android:layout_height="81dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/logo_alira" />

        <!-- ===================== CONTEÚDO ROLÁVEL ===================== -->
        <ScrollView
            android:id="@+id/scroll_perfil"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header_bar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="48dp">

                <!-- ===================== TÍTULO ===================== -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/rela_buttonback"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="28dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Perfil"
                        android:textColor="#E0E0E0"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adicione aqui suas informações"
                        android:textColor="#ffff"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- ===================== FOTO DE PERFIL ===================== -->
                <FrameLayout
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="40dp">

                    <!-- borda cinza -->
                    <FrameLayout
                        android:id="@+id/avatar_border"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/profile_avatar_border"
                        android:padding="8dp">

                        <ImageView
                            android:id="@+id/img_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_avatar"
                            android:clickable="true"
                            android:clipToOutline="true"
                            android:contentDescription="Foto de perfil"
                            android:focusable="true"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_person" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/btn_camera"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/profile_camera_btn"
                        android:clickable="true"
                        android:contentDescription="Alterar foto de perfil"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="10dp"
                        android:src="@drawable/ic_camera" />
                </FrameLayout>

                <!-- ===================== CAMPOS ===================== -->
                <EditText
                    android:id="@+id/et_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="28dp"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/profile_field_bg"
                    android:hint="Username"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords"
                    android:minHeight="64dp"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp"
                    android:tag="compacto"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B0B0B0"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="28dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/profile_field_bg"
                    android:hint="Email"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:minHeight="64dp"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp"
                    android:tag="compacto"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B0B0B0"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_telefone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="28dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/profile_field_bg"
                    android:hint="Telefone"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:minHeight="64dp"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp"
                    android:tag="compacto"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B0B0B0"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_genero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="28dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/profile_field_bg"
                    android:hint="Gênero"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:minHeight="64dp"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp"
                    android:tag="compacto"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B0B0B0"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_nascimento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="28dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/profile_field_bg"
                    android:hint="Data de nascimento"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="10"
                    android:minHeight="64dp"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp"
                    android:tag="compacto"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B0B0B0"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- CUIDADOR: estes dados vão também para o relógio (Configurações > Cuidador)
                     e o telefone é o número que recebe o SMS de emergência. -->
                <EditText
                    android:id="@+id/et_cuidador_nome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="28dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/profile_field_bg"
                    android:hint="Nome do cuidador"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords"
                    android:minHeight="64dp"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp"
                    android:tag="compacto"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B0B0B0"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_telefone_adicional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="28dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/profile_field_bg"
                    android:hint="Telefone do cuidador"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:minHeight="64dp"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp"
                    android:tag="compacto"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B0B0B0"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_cuidador_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="28dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/profile_field_bg"
                    android:hint="E-mail do cuidador"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:minHeight="64dp"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp"
                    android:tag="compacto"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B0B0B0"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_cuidador_parentesco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="28dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/profile_field_bg"
                    android:hint="Parentesco do cuidador"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapSentences"
                    android:minHeight="64dp"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp"
                    android:tag="compacto"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B0B0B0"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Deficiência: não é digitada. Tocar abre uma lista com caixinhas
                     (PerfilActivity.escolherDeficiencias), para o relógio entender. -->
                <EditText
                    android:id="@+id/et_deficiencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="28dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/profile_field_bg"
                    android:hint="Deficiência"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:minHeight="64dp"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp"
                    android:tag="compacto"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B0B0B0"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===================== MENU LATERAL ===================== -->
    <include
        layout="@layout/layout_drawer_menu"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
