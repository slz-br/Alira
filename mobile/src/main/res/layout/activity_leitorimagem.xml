<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#242029"
    tools:context=".LeitorImagemActivity">

    <!-- ===================== CONTEÚDO PRINCIPAL (1º filho do DrawerLayout) ===================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ===================== CÂMERA (área grande da tela) ===================== -->
        <androidx.camera.view.PreviewView
            android:id="@+id/preview_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="88dp"
            app:implementationMode="compatible"
            app:layout_constraintBottom_toTopOf="@id/bottom_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:scaleType="fillCenter" />

        <!-- Mensagem quando a câmera não está liberada -->
        <TextView
            android:id="@+id/txt_sem_camera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:text="Permita o acesso à câmera para tirar fotos ou use o botão + para escolher uma imagem da galeria."
            android:textColor="#B8B8B8"
            android:textSize="18sp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Botão que abre o menu -->
        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="96dp"
            android:layout_height="72dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Abrir menu"
            android:padding="10dp"
            android:src="@drawable/ic_menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/imageView3"
            android:contentDescription="Logo Alira, voltar para a tela inicial"
            android:layout_width="114dp"
            android:layout_height="81dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/logo_alira" />

        <!-- ===================== AVISO AZUL (aparece e some sozinho) ===================== -->
        <LinearLayout
            android:id="@+id/banner_aviso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:layout_marginTop="66dp"
            android:layout_marginEnd="60dp"
            android:background="@drawable/leitor_banner_bg"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="6dp"
            android:paddingEnd="22dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Leitor de Imagem"
                android:textColor="#E0E0E0"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Tire foto ou anexe arquivos para serem transcritos"
                android:textColor="#B8B8B8"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- ===================== BARRA INFERIOR ===================== -->
        <View
            android:id="@+id/bottom_bar"
            android:layout_width="0dp"
            android:layout_height="78dp"
            android:background="#151515"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Botão roxo: abre a galeria -->
        <ImageView
            android:id="@+id/btn_galeria"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="17dp"
            android:background="@drawable/profile_camera_btn"
            android:clickable="true"
            android:contentDescription="Escolher imagem da galeria"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_plus"
            app:layout_constraintBottom_toBottomOf="@id/bottom_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/bottom_bar" />

        <!-- Botão branco: tira a foto -->
        <View
            android:id="@+id/btn_capturar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/leitor_shutter"
            android:clickable="true"
            android:contentDescription="Tirar foto e ler o texto"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="@id/bottom_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/bottom_bar" />

        <!-- ===================== CARREGANDO ===================== -->
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="#9B59B6"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ===================== RESULTADO (texto encontrado) ===================== -->
        <LinearLayout
            android:id="@+id/result_panel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="100dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/leitor_panel_bg"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Texto encontrado"
                android:textColor="#E0E0E0"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:layout_weight="1"
                android:overScrollMode="never">

                <TextView
                    android:id="@+id/txt_resultado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textIsSelectable="true"
                    android:textSize="20sp" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_ouvir"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/acc_pill_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:tag="botao"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="Ouvir de novo"
                    android:textColor="#E0E0E0"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_fechar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/leitor_btn_purple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:tag="botao"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="Fechar"
                    android:textColor="#E0E0E0"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===================== MENU LATERAL ===================== -->
    <include
        layout="@layout/layout_drawer_menu"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>